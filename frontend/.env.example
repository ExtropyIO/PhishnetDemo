# Build-time PUBLIC config (exposed to client). Do NOT put secrets here.
# Mode: 'agentverse' | 'ecs'
VITE_DEFAULT_MODE=agentverse

# Secure proxy (API Gateway) base URL - e.g. https://abc.execute-api.eu-west-1.amazonaws.com/prod
VITE_AGENTVERSE_PROXY_BASE=

# (Optional fallback for resolve if you skip proxy resolve)
VITE_AGENTVERSE_BASE_URL=https://agentverse.ai/v1

# Sender / targets (bech32)
VITE_SENDER=agent1qYOUR_SENDER...
VITE_ADDR_INTAKE=agent1q...
VITE_ADDR_ANALYZER=agent1q...
VITE_ADDR_REFEREE=agent1q...
VITE_ADDR_ONCHAIN=agent1q...

# Protocol schema
VITE_SCHEMA_DIGEST=chat-protocol-v1
VITE_PROTOCOL_DIGEST=

# ECS
VITE_ECS_BASE_URL=
VITE_ECS_INVOKE_PATH=/{service}/invoke
VITE_ECS_REQ_TYPE=AnalyzeRequest
VITE_ECS_EXTRA=
